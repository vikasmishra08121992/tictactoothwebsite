# Local development. Gitignored — never commit this file.
#
# These credentials were shared in a chat transcript. Rotate them in
# Project Settings → API keys before this project holds any real booking.

# --- Supabase -----------------------------------------------------------------
# Safe to expose: these reach the browser by design. That is only acceptable
# because RLS denies `anon` every table (supabase/migrations/0002_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=https://yrlkonmcjiycrghmphne.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_2RTPNQf7qUUXnC10HdmzOQ_bulfjtUt

# NOT public. Bypasses RLS entirely. Server-side only — creating staff accounts
# and scheduled jobs. Deliberately has no NEXT_PUBLIC_ prefix so Next.js cannot
# inline it into a client bundle. If this key leaks, every patient record is
# readable by whoever holds it.
SUPABASE_SECRET_KEY=sb_secret_W3xBuVdYGxtO9oAKuExA-Q_orsnuVH9
SUPABASE_SERVICE_ROLE_KEY=sb_secret_W3xBuVdYGxtO9oAKuExA-Q_orsnuVH9

# --- Scheduled jobs -----------------------------------------------------------
# Shared secret for the Vercel Cron endpoint (pending expiry, retention purge).
# The endpoint refuses to run at all if this is unset — an unauthenticated URL
# that deletes patient records is worse than one that never fires.
CRON_SECRET=local-dev-cron-6f2a91c4

# --- Rate limiting ------------------------------------------------------------
# Salt for hashing visitor IP addresses in the booking rate-limit ledger. We
# count requests per device without ever storing an address that identifies
# anyone. Keep it separate from CRON_SECRET: rotating this resets every
# in-flight rate-limit window, and rotating the cron credential should not.
IP_HASH_SALT=local-dev-salt-b83d17e0

# --- Notifications ------------------------------------------------------------
# Left blank for local testing. Sends will be recorded in notification_log as
# failed attempts, which is honest and never blocks a booking.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_TEMPLATE_BOOKING_RECEIVED=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=

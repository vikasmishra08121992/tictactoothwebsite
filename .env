# =============================================================================
# DO NOT PUT REAL VALUES IN THIS FILE.
#
# This file is committed to git. It exists only to record which environment
# variables the application needs, so a deploy target knows what to set.
# Every value here is intentionally empty.
#
# Real values go in one of two places, and never here:
#
#   Local development -> .env.local   (gitignored, never committed)
#   Vercel            -> Project Settings > Environment Variables
#
# Next.js looks up variables in this order, stopping at the first hit:
#   process.env  >  .env.local  >  .env
# so the blanks below can never override a real value set anywhere else.
#
# A previous commit in this repository did contain real values, including the
# Supabase service-role key, which bypasses every row-level security rule
# protecting patient records. Those keys must be treated as compromised and
# rotated. Do not repeat it.
# =============================================================================


# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored — never commit real keys.

# --- Supabase -----------------------------------------------------------------
# Safe to expose: these reach the browser by design. That is only acceptable
# because RLS denies `anon` every table (supabase/migrations/0002_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT public. Bypasses RLS entirely. Server-side only — creating staff accounts
# and scheduled jobs. Deliberately has no NEXT_PUBLIC_ prefix so Next.js cannot
# inline it into a client bundle. If this key leaks, every patient record is
# readable by whoever holds it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduled jobs -----------------------------------------------------------
# Shared secret for the Vercel Cron endpoint (pending expiry, retention purge).
# The endpoint refuses to run at all if this is unset — an unauthenticated URL
# that deletes patient records is worse than one that never fires.
CRON_SECRET=

# --- Rate limiting ------------------------------------------------------------
# Salt for hashing visitor IP addresses in the booking rate-limit ledger. We
# count requests per device without ever storing an address that identifies
# anyone. Keep it separate from CRON_SECRET: rotating this resets every
# in-flight rate-limit window, and rotating the cron credential should not.
IP_HASH_SALT=

# --- Notifications ------------------------------------------------------------
# Email ships first. WhatsApp stays off until the Meta Business verification,
# BSP account and template approval are in place — see DECISIONS.md.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

WHATSAPP_ENABLED=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_TEMPLATE_BOOKING_RECEIVED=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=

# --- Google reviews -----------------------------------------------------------
# Fetched server-side from the Places API and cached for six hours, so no
# third-party script ever reaches the browser. Both unset = the reviews
# section does not render and the page links to Google instead. Never a
# placeholder review.
#
# Enable "Places API (New)" on a Google Cloud project, create a key restricted
# to that API, and find the Place ID for the hospital's Business Profile.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
